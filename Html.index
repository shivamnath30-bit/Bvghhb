<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shadi kr le - Matrimonial</title>
    <style>
        /* General Body Styling: Yellow background, Pink text */
        body {
            background-color: yellow;
            color: deeppink;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }

        /* Main Heading Styling: Red color */
        h1 {
            color: red;
            text-align: center;
            font-size: 3em;
            text-transform: uppercase;
            border-bottom: 3px solid red;
            padding-bottom: 10px;
        }

        /* Subheadings */
        h2 {
            color: deeppink;
            text-align: center;
            text-decoration: underline;
        }

        /* Layout Container for Side-by-Side forms */
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
            gap: 20px;
        }

        /* Individual Form Sections (Boy/Girl) */
        .form-section {
            background-color: #fffacd; /* Light lemon chiffon to make fields pop slightly */
            border: 2px solid deeppink;
            border-radius: 10px;
            padding: 20px;
            width: 45%;
            box-sizing: border-box;
            min-width: 300px;
        }

        /* Input Labels and Fields */
        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
        }

        input[type="text"], 
        input[type="date"], 
        input[type="number"] {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            border: 1px solid deeppink;
            border-radius: 4px;
            box-sizing: border-box;
            color: #333; /* Dark text for typing */
        }

        /* Frames for File Uploads */
        .upload-frame {
            border: 2px dashed deeppink;
            background-color: #ffe4e1; /* MistyRose background for frames */
            padding: 20px;
            margin-top: 15px;
            text-align: center;
            border-radius: 8px;
        }

        .upload-frame p {
            margin: 0 0 10px 0;
            font-weight: bold;
            color: red;
        }

        /* Submit Button Styling */
        .submit-btn {
            display: block;
            width: 250px;
            margin: 40px auto;
            padding: 15px;
            background-color: red;
            color: yellow;
            border: 2px solid deeppink;
            border-radius: 8px;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
        }

        .submit-btn:hover {
            background-color: darkred;
        }
    </style>
</head>
<body>

    <h1>Shadi kr le</h1>

    <form action="#" method="POST" enctype="multipart/form-data">
        <div class="container">
            
            <!-- BOY DETAILS SECTION -->
            <div class="form-section">
                <h2>Boy Details</h2>
                
                <label>Name:</label>
                <input type="text" name="boy_name" required>

                <label>Date of Birth:</label>
                <input type="date" name="boy_dob" required>

                <label>Aadhar Number:</label>
                <input type="number" name="boy_aadhar" required>

                <label>PAN Number:</label>
                <input type="text" name="boy_pan" required>

                <label>Village:</label>
                <input type="text" name="boy_village" required>

                <label>Post:</label>
                <input type="text" name="boy_post" required>

                <label>District:</label>
                <input type="text" name="boy_district" required>

                <label>Police Station:</label>
                <input type="text" name="boy_ps" required>

                <label>Pin Code:</label>
                <input type="number" name="boy_pincode" required>

                <label>State:</label>
                <input type="text" name="boy_state" required>

                <label>Country:</label>
                <input type="text" name="boy_country" value="India" required>

                <!-- Document Upload Frames for Boy -->
                <div class="upload-frame">
                    <p>Upload Photo</p>
                    <input type="file" name="boy_photo" accept="image/*" required>
                </div>

                <div class="upload-frame">
                    <p>Upload Aadhar Card</p>
                    <input type="file" name="boy_aadhar_doc" accept=".pdf, image/*" required>
                </div>

                <div class="upload-frame">
                    <p>Upload PAN Card</p>
                    <input type="file" name="boy_pan_doc" accept=".pdf, image/*" required>
                </div>
            </div>

            <!-- GIRL DETAILS SECTION -->
            <div class="form-section">
                <h2>Girl Details</h2>
                
                <label>Name:</label>
                <input type="text" name="girl_name" required>

                <label>Date of Birth:</label>
                <input type="date" name="girl_dob" required>

                <label>Aadhar Number:</label>
                <input type="number" name="girl_aadhar" required>

                <label>PAN Number:</label>
                <input type="text" name="girl_pan" required>

                <label>Village:</label>
                <input type="text" name="girl_village" required>

                <label>Post:</label>
                <input type="text" name="girl_post" required>

                <label>District:</label>
                <input type="text" name="girl_district" required>

                <label>Police Station:</label>
                <input type="text" name="girl_ps" required>

                <label>Pin Code:</label>
                <input type="number" name="girl_pincode" required>

                <label>State:</label>
                <input type="text" name="girl_state" required>

                <label>Country:</label>
                <input type="text" name="girl_country" value="India" required>

                <!-- Document Upload Frames for Girl -->
                <div class="upload-frame">
                    <p>Upload Photo</p>
                    <input type="file" name="girl_photo" accept="image/*" required>
                </div>

                <div class="upload-frame">
                    <p>Upload Aadhar Card</p>
                    <input type="file" name="girl_aadhar_doc" accept=".pdf, image/*" required>
                </div>

                <div class="upload-frame">
                    <p>Upload PAN Card</p>
                    <input type="file" name="girl_pan_doc" accept=".pdf, image/*" required>
                </div>
            </div>

        </div>

        <button type="submit" class="submit-btn">Submit Profiles</button>
    </form>

</body>
</html>
